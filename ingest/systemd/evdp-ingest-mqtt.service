[Unit]
Description=EVDP MQTT ingester (Mosquitto -> SQLite)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/evdp/ingest
# EVDP_MQTT_HOST / EVDP_MQTT_USER / EVDP_MQTT_PASS; mode 600, never in git
EnvironmentFile=%h/evdp/mqtt.env
ExecStart=%h/evdp/venv/bin/python -u %h/evdp/ingest/ingest_mqtt.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
