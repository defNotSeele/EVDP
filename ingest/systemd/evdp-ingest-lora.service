[Unit]
Description=EVDP LoRa ingester (Node 3 serial -> SQLite)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/evdp/ingest
Environment=EVDP_DB=%h/evdp/telemetry.db
Environment=EVDP_LORA_PORT=/dev/serial/by-id/usb-Espressif_Systems_seeed-xiao-s3_E83DC1FC83D0-if00
ExecStart=%h/evdp/venv/bin/python -u %h/evdp/ingest/ingest_lora.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
